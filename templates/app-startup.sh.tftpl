#!/bin/bash
set -euo pipefail
exec >/var/log/vprofile-startup.log 2>&1

if ! id devops >/dev/null 2>&1; then
  useradd -m -s /bin/bash devops
fi

echo 'devops ALL=(ALL) NOPASSWD:ALL' >/etc/sudoers.d/devops
install -d -m 700 -o devops -g devops /home/devops/.ssh
cat >/home/devops/.ssh/authorized_keys <<'KEY'
${ssh_public_key}
KEY
chown -R devops:devops /home/devops/.ssh
chmod 600 /home/devops/.ssh/authorized_keys

export DEBIAN_FRONTEND=noninteractive
apt-get update -y
apt-get install -y openjdk-17-jdk git wget unzip zip rsync mysql-client

TOMCAT_VERSION="10.1.26"
MAVEN_VERSION="3.9.9"
mkdir -p /usr/local
wget -q "https://archive.apache.org/dist/tomcat/tomcat-10/v$${TOMCAT_VERSION}/bin/apache-tomcat-$${TOMCAT_VERSION}.tar.gz" -O /tmp/tomcat.tar.gz
tar -xzf /tmp/tomcat.tar.gz -C /tmp
if ! id tomcat >/dev/null 2>&1; then
  useradd --shell /usr/sbin/nologin --system tomcat
fi
rm -rf /usr/local/tomcat
mv "/tmp/apache-tomcat-$${TOMCAT_VERSION}" /usr/local/tomcat
chown -R tomcat:tomcat /usr/local/tomcat

cat >/etc/systemd/system/tomcat.service <<'SERVICE'
[Unit]
Description=Apache Tomcat 10
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=tomcat
Group=tomcat
Environment="JAVA_HOME=/usr/lib/jvm/java-17-openjdk-amd64"
Environment="CATALINA_HOME=/usr/local/tomcat"
Environment="CATALINA_BASE=/usr/local/tomcat"
ExecStart=/usr/local/tomcat/bin/catalina.sh run
ExecStop=/usr/local/tomcat/bin/catalina.sh stop 15 -force
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
SERVICE

systemctl daemon-reload
systemctl enable tomcat

wget -q "https://archive.apache.org/dist/maven/maven-3/$${MAVEN_VERSION}/binaries/apache-maven-$${MAVEN_VERSION}-bin.zip" -O /tmp/maven.zip
unzip -q /tmp/maven.zip -d /usr/local
ln -sfn "/usr/local/apache-maven-$${MAVEN_VERSION}" /usr/local/maven

rm -rf /opt/vprofile
git clone --depth 1 --branch "${app_branch}" "${app_repository}" /opt/vprofile
sed -i 's/^jdbc.password=.*/jdbc.password=${db_password}/' /opt/vprofile/src/main/resources/application.properties
cd /opt/vprofile
/usr/local/maven/bin/mvn -B -DskipTests package
rm -rf /usr/local/tomcat/webapps/ROOT*
cp target/vprofile-v2.war /usr/local/tomcat/webapps/ROOT.war
systemctl restart tomcat

for attempt in $(seq 1 60); do
  if mysqladmin ping -h vprodb.vprofile.internal -u root -p'${db_password}' --silent; then
    mysql -h vprodb.vprofile.internal -u root -p'${db_password}' accounts </opt/vprofile/src/main/resources/db_backup.sql || true
    break
  fi
  sleep 10
done